{
  "manifest_version": 3,
  "name": "r1ytm",
  "short_name": "r1ytm",
  "version": "2.7",
  "description": "A floating glass control bar for YouTube Music. Unofficial, not affiliated with YouTube or Google.",
  "minimum_chrome_version": "104",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
